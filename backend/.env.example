## FastAPI backend configuration
#
# Copy to `backend/.env` and fill in values.
# Never commit real secrets.

# ─────────────────────────────────────────────────────────────
#  OpenAI Configuration (PRIMARY — used first if key is set)
#  Get your key: https://platform.openai.com/api-keys
# ─────────────────────────────────────────────────────────────
OPENAI_API_KEY=YOUR_OPENAI_API_KEY_HERE
# Options: gpt-4o, gpt-4o-mini, gpt-4-turbo, gpt-3.5-turbo
OPENAI_MODEL=gpt-4o-mini

# ─────────────────────────────────────────────────────────────
#  Gemini Configuration (FALLBACK — used if OpenAI key not set)
# ─────────────────────────────────────────────────────────────
# Gemini API key (Google AI Studio)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE

# Optional: choose a model
# Examples: gemini-1.5-flash, gemini-1.5-pro
GEMINI_MODEL=gemini-1.5-flash

# PostgreSQL connection string (pure PostgreSQL — no Supabase)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql://postgres:yourpassword@localhost:5432/civilization_mapper

# Gmail SMTP (for password reset OTP emails)
GMAIL_SENDER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password
GMAIL_DISPLAY_NAME=Civilization Spatial Mapper
